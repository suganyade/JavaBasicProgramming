+import java.util.Scanner;
+
+public class ArmstrongNum {
+    public static void main(String[] args) {
+        Scanner sc = new Scanner(System.in);
+        int num= sc.nextInt();
+        int  originalNum =num;
+        int sum=0;
+        while(num!=0){
+
+            int temp= num%10;
+            sum=sum+(temp*temp*temp);
+            num=num/10;
+
+        }
+        if (sum == originalNum) {
+            System.out.println("This is an armstong number");
+        }else{
+            System.out.println("Not an armbstrong");
+        }
